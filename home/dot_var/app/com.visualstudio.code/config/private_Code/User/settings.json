{
	// F# and YAML files should default to using spaces (everything else defaults to tabs).
	"[fsharp,yaml]": {
		"editor.insertSpaces": true,
		"editor.tabSize": 2
	},

	// Automatically close the console when the debug session ends.
	"debug.console.closeOnEnd": false,

	// Run dev containers under Podman on the host system.
	"dev.containers.dockerPath": "/app/tools/podman/bin/podman-remote",

	// Disable code folding.
	"editor.folding": false,

	// Enable ligatures in supported fonts.
	"editor.fontLigatures": true,

	// Reduce default font size.
	"editor.fontSize": 12.5,

	// Only show inlay hints when keys are held down.
	"editor.inlayHints.enabled": "offUnlessPressed",

	// Don't insert spaces when pressing tab.
	"editor.insertSpaces": false,

	// Use scrollbar instead of minimap.
	"editor.minimap.enabled": false,

	// Show the line hightlight in the gutter.
	"editor.renderLineHighlight": "all",

	// Wrap lines at the viewport width.
	"editor.wordWrap": "on",

	// Don't select open files in the explorer.
	"explorer.autoReveal": false,

	// Disable extension recommendations.
	"extensions.ignoreRecommendations": true,

	// Treat files as if they were of other types
	"files.associations": {
		"justfile": "makefile",
		".chezmoiignore": "ignore",
		".chezmoiroot": "ignore",
		"*rc": "ini",
		"*.container": "ini",
		"*.env": "properties",
		"*.hadolint": "yaml",
		"*.meta": "json",
		"*.network": "ini",
		"*.restext": "ini",
		"*.service": "ini",
		"*.socket": "ini",
		"*.timer": "ini",
		"*.yamllint": "yaml"
	},

	// Automatically save modified files.
	"files.autoSave": "afterDelay",

	// When opening new tabs, default to the language of the previously open tab.
	"files.defaultLanguage": "${activeEditorLanguage}",

	// Automatically fetch commits from git remotes.
	"git.autofetch": "all",

	// Don't confirm when syncing repositories.
	"git.confirmSync": false,

	// Commit all unstaged changes when there are no staged changes.
	"git.enableSmartCommit": true,

	// Always open parent git repositories.
	"git.openRepositoryInParentFolders": "always",

	// Disable telemetry for RedHat extensions.
	// https://github.com/redhat-developer/vscode-redhat-telemetry.
	"redhat.telemetry.enabled": false,

	// Disable trusted windows.
	"security.workspace.trust.enabled": false,

	// Disable telemetry.
	"telemetry.telemetryLevel": "off",

	// Use an I-beam style cursor in the terminal.
	"terminal.integrated.cursorStyle": "line",

	// Disable JavaScript and TypeScript survey prompts.
	"typescript.surveys.enabled": false,

	// Update paths to imported modules when moving JavaScript and TypeScript files.
	"typescript.updateImportsOnFileMove.enabled": "always",

	// Disable update checks (rely on the system's package manager).
	"update.mode": "none",

	// Automatically switch between light and dark themes based on the operating system's appearance setting.
	"window.autoDetectColorScheme": true,

	// Don't restore windows on cold start.
	"window.restoreWindows": "none",

	// Use the modern themes.
	"workbench.colorTheme": "Default Light Modern",
	"workbench.preferredDarkColorTheme": "Default Dark Modern",
	"workbench.preferredLightColorTheme": "Default Light Modern",
	"workbench.editor.enablePreview": false,

	// Remaps list/tree (file/folder) click behaviour:
	// - Single click to select.
	// - Double click to open/expand.
	"workbench.list.openMode": "doubleClick",
	"workbench.tree.expandMode": "doubleClick",

	// Disable the welcome screen.
	"workbench.startupEditor": "none",

	// Increase tree indent in the explorer.
	"workbench.tree.indent": 20,

	// Enable the Zig language server.
	"zig.zls.enabled": "on"
}